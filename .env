# CosCon Pay — Cloudflare runtime configuration.
#
# D1 + R1/R2 are BINDINGS, not env vars — they live in wrangler.toml and are
# injected as `env.DB` / `env.R1_STORE` on the Worker (or by `wrangler dev`).
#
# ── Required ────────────────────────────────────────────────────────────
# Signing secret for the encrypted admin session cookie (used by
# src/lib/admin-auth.functions.ts). Use a long random string, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET="MERA_LAND_LE_LE_YE_HACK_KARNE_WALA_HACKER"

# ── Optional for wrangler CLI ───────────────────────────────────────────
# CLOUDFLARE_ACCOUNT_ID=""
